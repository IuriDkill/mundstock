{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mundstock",
  "compatibility_date": "2026-10-01",
  // Static site only: Cloudflare serves the Vite build straight from its edge, no Worker script needed.
  // Custom domains: Cloudflare creates the DNS records and HTTPS certificate on deploy.
  "routes": [
    { "pattern": "mundstock.dev.br", "custom_domain": true },
    { "pattern": "www.mundstock.dev.br", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
